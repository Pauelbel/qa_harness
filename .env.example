# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Окружение: dev, stage или prod
TEST_ENV=stage
# Откуда брать секреты: env (переменные ниже) или vault
SECRETS_SOURCE=env

# Секреты: префикс окружения + ключ, тест читает ACTIVE_CONFIG["app_api_url"]
STAGE_APP_API_URL=https://app-stage.example.com
STAGE_APP_API_TOKEN=
STAGE_APP_DB_HOST=
STAGE_APP_DB_PORT=5432
STAGE_APP_DB_NAME=
STAGE_APP_DB_USER=
STAGE_APP_DB_PASSWORD=
STAGE_APP_FRONTEND_URL=https://app-stage.example.com
STAGE_APP_FRONTEND_LOGIN=
STAGE_APP_FRONTEND_PASSWORD=
STAGE_CRM_URL=https://crm-stage.example.com
STAGE_CRM_TOKEN=

# Vault (SECRETS_SOURCE=vault): ключи без префикса (APP_API_TOKEN), {env} в пути — окружение
# VAULT_ADDR=https://vault.example.com
# VAULT_MOUNT=secret
# VAULT_PATH=myapp/{env}
# VAULT_KV_VERSION=2
# VAULT_TOKEN=                       или AppRole: VAULT_ROLE_ID= и VAULT_SECRET_ID=
# VAULT_CACERT=/path/to/ca.pem       или VAULT_VERIFY=false

# Браузер без окна (CI)
# HEADLESS=true

# DQ-отчёты: удалять после тестов и куда сохранять
# KEEP_DQ_REPORTS=false
# DQ_REPORTS_OUTPUT_DIR=reports/dq

# Версия тестируемого приложения — во вкладку Environment отчёта Allure (обычно задаёт CI)
# APP_VERSION=
# Корень артефактов запусков (по умолчанию artifacts/ в корне репозитория)
# ARTIFACTS_DIR=
