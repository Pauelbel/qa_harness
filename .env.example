# ------------------------------------------------------------------------
# Настройки окружения: скопируйте в .env в корне запуска (рядом с pytest.ini) и заполните
# .env исключён из git; в рабочем проекте он лежит в корне проекта, а не в harness/
# ------------------------------------------------------------------------

# Окружение: dev, stage или prod
TEST_ENV=stage
# Откуда брать секреты: env (переменные ниже) или vault (нужен плагин qa.vault)
SECRETS_SOURCE=env

# ------------------------------------------------------------------------
# Секреты: префикс окружения + ключ, тест читает ACTIVE_CONFIG["app_api_url"]
# ------------------------------------------------------------------------
STAGE_APP_API_URL=https://app-stage.example.com
STAGE_APP_API_TOKEN=
STAGE_APP_DB_HOST=
STAGE_APP_DB_PORT=5432
STAGE_APP_DB_NAME=
STAGE_APP_DB_USER=
STAGE_APP_DB_PASSWORD=
STAGE_APP_FRONTEND_URL=https://app-stage.example.com
STAGE_APP_FRONTEND_LOGIN=
STAGE_APP_FRONTEND_PASSWORD=
STAGE_CRM_URL=https://crm-stage.example.com
STAGE_CRM_TOKEN=

# ------------------------------------------------------------------------
# Vault: используется при SECRETS_SOURCE=vault
# Ключи без префикса окружения, {env} в пути заменяется на dev, stage или prod
# ------------------------------------------------------------------------
# VAULT_ADDR=https://vault.example.com
# VAULT_MOUNT=secret
# VAULT_PATH=myapp/{env}
# VAULT_KV_VERSION=2
# VAULT_TOKEN=                       или AppRole: VAULT_ROLE_ID= и VAULT_SECRET_ID=
# VAULT_CACERT=/path/to/ca.pem       или VAULT_VERIFY=false

# ------------------------------------------------------------------------
# Браузер: HEADLESS=true запускает без окна, например в CI
# ------------------------------------------------------------------------
# HEADLESS=true

# ------------------------------------------------------------------------
# DQ-отчёты: удаление после тестов и каталог скачивания
# ------------------------------------------------------------------------
# KEEP_DQ_REPORTS=false
# DQ_REPORTS_OUTPUT_DIR=reports/dq

# ------------------------------------------------------------------------
# Артефакты запуска: версия приложения в Allure и корневой каталог результатов
# ------------------------------------------------------------------------
# APP_VERSION=
# Корень артефактов запусков (по умолчанию artifacts/ в корне запуска — там, где pytest.ini)
# ARTIFACTS_DIR=
